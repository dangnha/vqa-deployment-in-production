# GPU image: torch + CUDA + cuDNN already come from the base image
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime
WORKDIR /app

# Requirements first (cached layer), WITHOUT torch: it is already installed
COPY requirements-cuda.txt .
RUN pip install --no-cache-dir -r requirements-cuda.txt

# Copy the code last: editing app/ only rebuilds this cheap layer
COPY app ./app

# Model cache in a mounted dir, and ask for the GPU by default
ENV HF_HOME=/hf_cache DEVICE=cuda

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
